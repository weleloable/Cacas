# Copia este archivo a .env y rellena los valores de tu proyecto de Supabase.
# Panel de Supabase -> Project Settings -> API
#
# Todo lo que empieza por EXPO_PUBLIC_ acaba dentro del bundle que se descarga
# el navegador o el móvil, así que aquí SOLO va la clave publishable/anon.
# La secret key nunca entra en la app.

EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
